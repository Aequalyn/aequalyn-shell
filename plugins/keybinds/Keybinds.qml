// Keybinds -- the service behind the Keyboard shortcuts page: it reads the
// keybinds Aequalyn ships in ~/.config/hypr/keybinds.lua, keeps the keys you
// chose in ~/.local/state/aequalyn/keybinds/overrides.json, and writes them
// back as a marked block at the end of that file: bin/keybinds-sync merges it
// in and reloads Hyprland, then checks your keys really are live.
//
// The universal clipboard (aequalyn/clipboard.lua), the window layouts' keys
// (they are (re)bound after every reload) and the web apps' keys are never
// editable: they are held as reserved, with their names, and a key one of them
// uses is refused. Hyprland itself gets the last word: after every change the
// service asks it whether your keys are really in use.
//
// IPC:  qs ipc call keybinds <reload|status|open>
import QtQuick
import Quickshell
import Quickshell.Io
import "js/Binds.js" as Binds

Item {
    id: root
    visible: false

    property var theme: null

    // ---- paths -----------------------------------------------------------------------
    readonly property string home: Quickshell.env("HOME") || ""
    readonly property string hyprDir: home + "/.config/hypr"
    readonly property string stateDir: (Quickshell.env("XDG_STATE_HOME") || home + "/.local/state")
        + "/aequalyn/keybinds"
    readonly property string helper: decodeURIComponent(String(Qt.resolvedUrl("bin/keybinds-sync")).replace(/^file:\/\//, ""))

    // ---- what the page reads ---------------------------------------------------------
    property var binds: []            // the catalogue: Aequalyn's binds, labelled and grouped
    property var groups: []           // the same, by group, as the page shows them
    property var warnings: []         // binds in the file this could not name
    property var reserved: ({})       // every key that is not on the page, and why
    property var reservedRows: []     // the same, as rows for the page's fold
    property var state: null           // { changed: {}, removed: [], custom: [] }, as saved
    property var status: ({ ok: false, active: "unknown", count: 0, changed: false, error: "", skipped: [] })
    property bool ready: false        // your saved keys have been read
    property bool dirReady: false     // the state folder exists, so writes can land

    // how many keys differ from what Aequalyn ships
    readonly property int differences: {
        if (!state) return 0
        let n = 0
        for (const k in state.changed) n++
        return n + state.removed.length + state.custom.length
    }

    function cloneState() {
        return state ? JSON.parse(JSON.stringify(state)) : Binds.newState()
    }

    // ---- the files -------------------------------------------------------------------
    function readText(fv) {
        try { return String(typeof fv.text === "function" ? fv.text() : fv.text) } catch (e) { return "" }
    }

    FileView {
        id: kbFile
        path: root.hyprDir + "/keybinds.lua"
        printErrors: false
        watchChanges: true
        onFileChanged: reload()
        onLoaded: { root.parseFiles(); root.reconcile() }
        onLoadFailed: root.parseFiles()
    }
    FileView {
        id: clipFile
        path: root.hyprDir + "/aequalyn/clipboard.lua"
        printErrors: false
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.parseFiles()
        onLoadFailed: root.parseFiles()
    }
    FileView {
        id: webFile
        path: root.hyprDir + "/webapps.lua"      // generated by aequalyn-webapp: its keys are held too
        printErrors: false
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.parseFiles()
        onLoadFailed: root.parseFiles()
    }
    FileView {
        id: overridesFile
        path: root.stateDir + "/overrides.json"
        printErrors: false
        onLoaded: root.absorbOverrides(root.readText(overridesFile))
        onLoadFailed: if (!root.ready) { root.ready = true; root.reconcile() }
    }
    // the block, written for the helper to merge into keybinds.lua
    FileView {
        id: blockFile
        path: root.stateDir + "/block.lua"
        printErrors: false
    }

    function parseFiles() {
        const p = Binds.parseBinds(readText(kbFile));
        binds = p.binds;
        warnings = p.warnings;
        reserved = Binds.reservedFromFiles(readText(clipFile), readText(webFile));
        reservedRows = Binds.reservedRows(reserved);
        const out = [];
        for (let g = 0; g < Binds.groupOrder.length; g++) {
            const key = Binds.groupOrder[g];
            const items = [];
            for (let i = 0; i < binds.length; i++) if (binds[i].group === key) items.push(binds[i]);
            if (items.length > 0)
                out.push({ key: key, title: Binds.groupTitles[key], hint: Binds.groupHints[key] || "", binds: items });
        }
        groups = out;
    }

    // ---- your keys -------------------------------------------------------------------
    function absorbOverrides(text) {
        if (ready) return;
        state = Binds.readState(text);
        ready = true;
        reconcile();
    }

    function currentKey(bind) { return Binds.currentKey(bind, state) }
    function chordText(chord) { return Binds.chordText(chord) }
    function customLabel(c) { return Binds.labelOfCustom(c) }

    // a key press, as one chord: "" while only modifiers are held, "" for a key
    // this cannot name (Hyprland names keys, and only those can be bound)
    property var keyTable: ({})
    readonly property var modifierKeys: {
        const m = {};
        const list = [Qt.Key_Shift, Qt.Key_Control, Qt.Key_Meta, Qt.Key_Alt, Qt.Key_AltGr,
                     Qt.Key_CapsLock, Qt.Key_NumLock, Qt.Key_ScrollLock, Qt.Key_Super_L, Qt.Key_Super_R,
                     Qt.Key_Hyper_L, Qt.Key_Hyper_R, Qt.Key_Direction_L, Qt.Key_Direction_R, Qt.Key_ModeSwitch];
        for (let i = 0; i < list.length; i++) m[list[i]] = true;
        return m;
    }
    function keyName(k) {
        if (k >= Qt.Key_A && k <= Qt.Key_Z) return String.fromCharCode(65 + k - Qt.Key_A);
        if (k >= Qt.Key_0 && k <= Qt.Key_9) return String.fromCharCode(48 + k - Qt.Key_0);
        if (k >= Qt.Key_F1 && k <= Qt.Key_F24) return "F" + (k - Qt.Key_F1 + 1);
        return keyTable[k] || "";
    }
    function buildKeyTable() {
        const pairs = [
            [Qt.Key_Escape, "ESCAPE"], [Qt.Key_Tab, "TAB"], [Qt.Key_Backtab, "TAB"],
            [Qt.Key_Backspace, "BACKSPACE"], [Qt.Key_Return, "RETURN"], [Qt.Key_Enter, "RETURN"],
            [Qt.Key_Insert, "INSERT"], [Qt.Key_Delete, "DELETE"], [Qt.Key_Pause, "PAUSE"],
            [Qt.Key_Print, "PRINT"], [Qt.Key_Clear, "CLEAR"], [Qt.Key_Home, "HOME"],
            [Qt.Key_End, "END"], [Qt.Key_Left, "LEFT"], [Qt.Key_Up, "UP"], [Qt.Key_Right, "RIGHT"],
            [Qt.Key_Down, "DOWN"], [Qt.Key_PageUp, "PAGEUP"], [Qt.Key_PageDown, "PAGEDOWN"],
            [Qt.Key_Menu, "MENU"], [Qt.Key_Space, "SPACE"], [Qt.Key_Comma, "COMMA"],
            [Qt.Key_Period, "PERIOD"], [Qt.Key_Slash, "SLASH"], [Qt.Key_Minus, "MINUS"],
            [Qt.Key_Equal, "EQUAL"], [Qt.Key_Semicolon, "SEMICOLON"], [Qt.Key_Apostrophe, "APOSTROPHE"],
            [Qt.Key_BracketLeft, "BRACKETLEFT"], [Qt.Key_BracketRight, "BRACKETRIGHT"],
            [Qt.Key_Backslash, "BACKSLASH"], [Qt.Key_QuoteLeft, "GRAVE"],
            [Qt.Key_VolumeMute, "XF86AUDIOMUTE"], [Qt.Key_VolumeDown, "XF86AUDIOLOWERVOLUME"],
            [Qt.Key_VolumeUp, "XF86AUDIORAISEVOLUME"], [Qt.Key_MicMute, "XF86AUDIOMICMUTE"],
            [Qt.Key_MediaPlay, "XF86AUDIOPLAY"], [Qt.Key_MediaPause, "XF86AUDIOPAUSE"],
            [Qt.Key_MediaStop, "XF86AUDIOSTOP"], [Qt.Key_MediaNext, "XF86AUDIONEXT"],
            [Qt.Key_MediaPrevious, "XF86AUDIOPREV"], [Qt.Key_MediaRecord, "XF86AUDIORECORD"],
            [Qt.Key_MonBrightnessUp, "XF86MONBRIGHTNESSUP"], [Qt.Key_MonBrightnessDown, "XF86MONBRIGHTNESSDOWN"],
            [Qt.Key_LaunchMail, "XF86MAIL"], [Qt.Key_LaunchMedia, "XF86AUDIOMEDIA"],
            [Qt.Key_Calculator, "XF86CALCULATOR"], [Qt.Key_HomePage, "XF86HOMEPAGE"],
            [Qt.Key_Search, "XF86SEARCH"], [Qt.Key_Favorites, "XF86FAVORITES"]
        ];
        const t = {};
        for (let i = 0; i < pairs.length; i++) if (pairs[i][0] !== undefined) t[pairs[i][0]] = pairs[i][1];
        keyTable = t;
    }
    function isModifierKey(k) { return modifierKeys[k] === true }
    function chordFromEvent(ev) {
        if (isModifierKey(ev.key)) return "";
        const name = keyName(ev.key);
        if (name === "") return "";
        const mods = [];
        if (ev.modifiers & Qt.ControlModifier) mods.push("CTRL");
        if (ev.modifiers & Qt.AltModifier) mods.push("ALT");
        if (ev.modifiers & Qt.ShiftModifier) mods.push("SHIFT");
        if (ev.modifiers & Qt.MetaModifier) mods.push("SUPER");
        return Binds.chordFromParts(mods, name);
    }

    // null when the key is free; the string "modifier" when a key alone would
    // be taken from every app; otherwise the name of the key's holder, in
    // plain words. `except` spares the bind being edited: { id: ... } for a
    // shipped bind whose key is changing, { custom: ... } for a made bind.
    function conflictFor(chord, except) {
        return Binds.conflict(chord, except, binds, state, reserved);
    }

    // ---- one change at a time -------------------------------------------------------
    // Every change keeps the state as it was, writes what it becomes, and asks
    // Hyprland through the helper. When the helper says the change was taken
    // back (the file restored), the state comes down with it, so the two are
    // never apart.
    property var lastGood: null

    function commit(next) {
        lastGood = cloneState();
        state = next;
        persist();
        apply();
    }

    // a shipped bind, onto your key (its own key: back as Aequalyn ships it)
    function moveKey(id, chord) {
        const norm = Binds.normalize(chord);
        const next = cloneState();
        if (norm === id) {
            delete next.changed[id];
            const i = next.removed.indexOf(id);
            if (i >= 0) next.removed.splice(i, 1);
        } else {
            next.changed[id] = norm;
            const i = next.removed.indexOf(id);
            if (i >= 0) next.removed.splice(i, 1);
        }
        commit(next);
    }

    // a shipped bind back on Aequalyn's own key
    function resetBind(id) {
        const next = cloneState();
        delete next.changed[id];
        commit(next);
    }

    // delete: a shipped bind's key does nothing any more
    function removeBind(id) {
        const next = cloneState();
        delete next.changed[id];
        if (next.removed.indexOf(id) < 0) next.removed.push(id);
        commit(next);
    }

    // take a delete back. "" when Aequalyn's own bind stands again; otherwise
    // the name of whoever took its key in the meantime.
    function restoreBind(id) {
        const i = state.removed.indexOf(id);
        if (i < 0) return "";
        const who = Binds.conflict(id, null, binds, state, reserved);
        if (who && who !== "modifier") return who;
        const next = cloneState();
        next.removed.splice(i, 1);
        commit(next);
        return "";
    }

    // a bind you made: a name, a command, a key. "" when it stands; otherwise
    // the reason it cannot (a taken key, or something to run missing).
    function addCustom(label, command, keys) {
        const norm = Binds.normalize(keys);
        if (norm === "" || String(command || "").trim() === "" || Binds.hasControl(command) || Binds.hasControl(label))
            return "say what the key should run, and press a whole chord for it";
        const who = conflictFor(norm, null);
        if (who === "modifier") return "add a modifier: a key alone would be taken from every app";
        if (who) return "that's " + who;
        const next = cloneState();
        next.custom.push({ keys: norm, label: String(label || ""), command: String(command) });
        commit(next);
        return "";
    }

    // a made bind, onto another key
    function setCustomKey(oldKeys, chord) {
        const norm = Binds.normalize(chord);
        if (norm === Binds.normalize(oldKeys)) return;
        const next = cloneState();
        for (let i = 0; i < next.custom.length; i++) {
            if (Binds.normalize(next.custom[i].keys) === Binds.normalize(oldKeys)) {
                next.custom[i].keys = norm;
                break;
            }
        }
        commit(next);
    }

    // remove a bind you made
    function removeCustom(keys) {
        const norm = Binds.normalize(keys);
        const next = cloneState();
        for (let i = 0; i < next.custom.length; i++) {
            if (Binds.normalize(next.custom[i].keys) === norm) { next.custom.splice(i, 1); break; }
        }
        commit(next);
    }

    // every key back to how Aequalyn ships it, and the ones you made gone
    function resetAll() { commit(Binds.newState()) }

    function persist() {
        if (!ready || !dirReady || !state) return;
        overridesFile.setText(JSON.stringify(state, null, 2) + "\n");
    }

    // ---- writing it to Hyprland ------------------------------------------------------
    // the block, from your keys as they stand now; written to the state
    // folder, and keybinds-sync merges it into keybinds.lua, reloads Hyprland
    // and asks it whether your keys are live. When Hyprland refuses the
    // change, the helper restores the file and says so here: the state comes
    // down with it, so the two are never apart.
    function reconcile() {
        if (!ready || !dirReady || binds.length === 0) return;
        apply();
    }
    function apply() {
        if (!ready || !dirReady || binds.length === 0) return;
        const gen = Binds.blockLua(binds, state);
        const skipped = [];
        for (let s = 0; s < gen.skipped.length; s++)
            skipped.push(gen.skipped[s].id + ": " + gen.skipped[s].why);
        status = Object.assign({}, status, { skipped: skipped });
        blockFile.setText(gen.text);
        runHelper("apply");
    }
    function runHelper(cmd) {
        if (syncProc.running) { syncAgain = true; return }
        syncProc.command = ["bash", helper, cmd];
        syncProc.running = true;
    }
    property bool syncAgain: false

    Process {
        id: syncProc
        stdout: StdioCollector {
            onStreamFinished: {
                let st;
                try { st = JSON.parse(String(text || "")) } catch (e) { st = null }
                if (!st || typeof st !== "object")
                    st = { ok: false, active: "unknown", count: 0, changed: false, restored: "false",
                           error: "the keybind helper gave no answer" };
                // the change was taken back: come down with the file
                if ((st.restored === "true" || st.restored === true) && root.lastGood) {
                    root.state = root.lastGood;
                    root.persist();
                    blockFile.setText(Binds.blockLua(root.binds, root.state).text);
                }
                root.status = Object.assign({}, st, {
                    skipped: root.status.skipped || [],
                    count: root.differences
                });
            }
        }
        onExited: if (root.syncAgain) { root.syncAgain = false; Qt.callLater(function () { root.runHelper("apply") }) }
    }

    Component.onCompleted: {
        buildKeyTable();
        KeybindsHost.svc = root;
        mkdirProc.running = true;
    }
    Component.onDestruction: if (KeybindsHost.svc === root) KeybindsHost.svc = null

    Process {
        id: mkdirProc
        command: ["mkdir", "-p", root.stateDir]
        onExited: {
            root.dirReady = true;
            overridesFile.reload();
            // the overrides may have been read while the folder was still being
            // made: their first write has been waiting since
            if (root.ready) root.reconcile();
        }
    }

    // ---- ipc -------------------------------------------------------------------------
    IpcHandler {
        target: "keybinds"

        // read the files again and make sure your keys are in place
        function reload(): void { root.parseFiles(); root.reconcile() }

        function status(): string { return JSON.stringify(root.status) }

        function open(): string { KeybindsHost.openPage(); return "ok" }

        // a bind of your own:  qs ipc call keybinds add "Snip" "grim -g ..." "SUPER + F9"
        function add(name: string, command: string, keys: string): string {
            const why = root.addCustom(name, command, keys);
            return why === "" ? "ok" : why;
        }

        // delete a bind: a shipped one by its id, a made one by its key
        function remove(id: string): string {
            const norm = Binds.normalize(id);
            for (let i = 0; i < root.state.custom.length; i++) {
                if (Binds.normalize(root.state.custom[i].keys) === norm) {
                    root.removeCustom(norm);
                    return "ok";
                }
            }
            root.removeBind(norm);
            return "ok";
        }

        // take a delete back
        function restore(id: string): string {
            const why = root.restoreBind(Binds.normalize(id));
            return why === "" ? "ok" : "that key is used by " + why;
        }
    }
}
