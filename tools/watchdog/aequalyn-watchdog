# The Hyprland session this supervisor belongs to. It must never outlive it: one left over from
# a session that was logged out of (started from a terminal, it survives the logout) hands every
# shell it starts that session's address, and the shell can no longer reach Hyprland at all.
HYPR_SIG = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def hyprland_alive(sig: str) -> bool:
    """Is the Hyprland of this signature still running? Without one, it cannot be told: yes."""
    if not sig:
        return True
    return any((base / sig / ".socket.sock").exists() for base in (RUNTIME / "hypr", Path("/tmp/hypr")))


def session_of(pid: int) -> str:
    """The Hyprland session a process was started in ("" when it cannot be read)."""
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for item in f.read().split(b"\0"):
                if item.startswith(b"HYPRLAND_INSTANCE_SIGNATURE="):
                    return item.split(b"=", 1)[1].decode("utf-8", "replace")
    except OSError:
        pass
    return ""


def of_ended_session(pid: int) -> bool:
    """Was this process started in another Hyprland session, one that has ended?"""
    sig = session_of(pid)
    return bool(sig) and sig != HYPR_SIG and not hyprland_alive(sig)

