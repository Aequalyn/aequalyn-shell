# ------------------------------------------------- root: the one gate ----
# A plugin may run as root ONLY through the gate here: it declares its
# actions up front (needsRoot in its manifest -- plugin.json for a Store
# plugin, a needsRoot: [...] line in Plugins.js for a built-in), and the
# only door is `aequalyn-watchdog exec-root <actionId>`, which pins the
# caller by its real process (SO_PEERCRED), asks the shell to show the
# escalation window naming the plugin and the exact command, and then runs
# the declared argv with `sudo -S` -- password on stdin, never in argv.
# A plugin that tries sudo/pkexec on its own is caught at runtime and
# treated like any other fault (killed, counted, turned off).

ROOT_ID_RE = re.compile(r"^[a-z][a-z0-9-]{0,39}$")
# what counts as a privilege launcher in the process tree (level 2)
ROOT_LAUNCHERS = {"sudo", "pkexec", "su", "doas"}
SHELL_LAUNCHERS = {"sh", "bash", "dash", "ash", "zsh", "fish", "ksh"}
PASS_THROUGH = {"env", "nohup", "setsid", "xargs", "nice", "stdbuf"}


def clean_root_actions(raw, where: str, builtin: bool = False) -> list[dict]:
    """Validate a manifest's needsRoot into safe actions, or [] if broken.
    The command is what the daemon will run AS ROOT: a fixed argv straight
    from the manifest, never something the plugin passes in, never a shell.
    A built-in's may be `interactive`: a program a person starts and stays in
    (the installer), which has no time limit and whose window comes first. One that
    takes nothing but a checked value (a colour) may be `quiet`: run without the window
    when sudo's own rules (aequalyn-gate-rules) let it without the password."""
    out: list[dict] = []
    if not isinstance(raw, list):
        return out
    for a in raw:
        if not isinstance(a, dict):
            continue
        aid, label, about = a.get("id", ""), str(a.get("label", ""))[:128], str(a.get("about", ""))[:512]
        cmd = a.get("command", [])
        if not ROOT_ID_RE.match(str(aid)):
            continue
        if not isinstance(cmd, list) or not (1 <= len(cmd) <= 64):
            continue
        argv: list[str] = []
        for x in cmd:
            s = str(x)
            if not s or len(s) > 512 or "\x00" in s or "\n" in s:
                argv = []
                break
            argv.append(s)
        if not argv or os.path.basename(argv[0]) in ROOT_LAUNCHERS:
            continue          # the gate adds sudo itself; nesting it is nonsense
        out.append({"id": str(aid), "label": label or str(aid), "command": argv, "about": about,
                    "interactive": builtin and a.get("interactive") is True,
                    "quiet": builtin and a.get("quiet") is True})
    seen: set[str] = set()
    clean = []
    for a in out:
        if a["id"] in seen:
            continue
        seen.add(a["id"])
        clean.append(a)
    if len(clean) > 8:
        log(f"{where}: more than 8 root actions declared, keeping the first 8")
        clean = clean[:8]
    return clean


def store_root_actions(pid: str) -> list[dict]:
    """Root actions declared in a Store plugin's plugin.json."""
    mf = STORE_DIR / pid / "plugin.json"
    d = read_json(mf, None)
    return clean_root_actions(d.get("needsRoot") if isinstance(d, dict) else None, str(mf))


def builtin_root_actions() -> dict[str, list[dict]]:
    """{builtin id: actions} from needsRoot: [...] in Plugins.js. The value
    may span lines, so the brackets are walked to their close across the
    whole text, and the plugin id is the nearest entry opener before the
    marker (rootTest declares one; it is the worked example)."""
    try:
        text = PLUGINS_JS.read_text(encoding="utf-8")
    except OSError:
        return {}
    out: dict[str, list[dict]] = {}
    for m in re.finditer(r"needsRoot\s*:", text):
        opens = re.findall(r'\{\s*id:\s*"([^"]+)"', text[:m.start()])
        if not opens:
            continue
        pid = opens[-1]
        j = text.find("[", m.end())
        if j < 0:
            continue
        depth, end = 0, -1
        for k in range(j, len(text)):
            if text[k] == "[":
                depth += 1
            elif text[k] == "]":
                depth -= 1
                if depth == 0:
                    end = k
                    break
        if end < 0:
            continue
        try:
            raw = json.loads(text[j:end + 1])
        except ValueError:
            continue
        acts = clean_root_actions(raw, "Plugins.js", builtin=True)
        if acts:
            out[pid] = acts
    return out


def root_actions_of(pid: str) -> list[dict]:
    if (STORE_DIR / pid / "plugin.json").is_file():
        return store_root_actions(pid)
    return builtin_root_actions().get(pid, [])


def allowed_root() -> dict:
    """{plugin id: {action id: true}} the user said 'always' to, from
    settings.json (only for labelling the window; consent is cosmetic)."""
    d = read_json(SETTINGS_FILE, {})
    out = {}
    if isinstance(d, dict) and isinstance(d.get("rootAllowed"), dict):
        for pid, acts in d["rootAllowed"].items():
            if isinstance(acts, dict):
                out[str(pid)] = {str(a) for a, v in acts.items() if v is True}
    return out


# ------------------------------------------------ process tree walking ----

def read_cmdline(pid: int) -> list[str] | None:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            args = f.read().decode("utf-8", "replace").split("\0")
        return [a for a in args if a] or None
    except OSError:
        return None


def children_of(pid: int) -> list[int]:
    try:
        with open(f"/proc/{pid}/task/{pid}/children", encoding="utf-8") as f:
            return [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        return []


def proc_session(pid: int) -> int | None:
    """The session id (SID) of a process, from /proc/<pid>/stat. A process
    launched with setsid() (a detached terminal, the user's own console)
    gets a NEW session, distinct from the shell's, so this is how the tripwire
    tells a person's terminal apart from the shell's own in-process children:
    only processes sharing the supervised unit's session are supervised."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
            s = f.read()
        i, j = s.find("("), s.rfind(")")
        if i < 0 or j < i:
            return None
        rest = s[j + 1:].split()
        # rest: state ppid pgrp session tty_nr ...
        return int(rest[3])
    except (OSError, ValueError, IndexError):
        return None

def tree_processes(pid: int, cap: int = 512, root_session: int | None = None) -> list[tuple[int, list[str]]]:
    """The pid and argv of a process and every descendant (a plugin's
    `sh -c` helpers included). Reads /proc only; nothing is spawned.

    When root_session is given, only processes in that session are returned:
    a child that called setsid() (a detached terminal -- the user's own
    console) and its whole subtree are pruned, because they stepped out of
    the supervised tree by design. None means "no filter" (back-compat)."""
    if root_session is None:
        root_session = proc_session(pid)
    out: list[tuple[int, list[str]]] = []
    seen: set[int] = set()
    stack = [pid]
    while stack and len(out) < cap:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        if root_session is not None and proc_session(p) != root_session:
            continue
        argv = read_cmdline(p)
        if argv is not None:
            out.append((p, argv))
        stack.extend(children_of(p))
    return out

def kill_tree(pid: int) -> None:
    """SIGKILL a process and everything under it, deepest first."""
    stack = [pid]
    allp: list[int] = []
    seen: set[int] = set()
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        allp.append(p)
        stack.extend(children_of(p))
    for p in reversed(allp):
        try:
            os.kill(p, signal.SIGKILL)
        except OSError:
            pass


def ancestors(pid: int, cap: int = 64) -> list[int]:
    """The pid and every parent up to init (cap on depth). Used to pin a
    socket caller to the supervised unit it really belongs to."""
    out: list[int] = []
    p = pid
    for _ in range(cap):
        out.append(p)
        try:
            with open(f"/proc/{p}/status", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("PPid:"):
                        p = int(line.split()[1])
                        break
        except (OSError, ValueError, IndexError):
            break
        if p <= 1:
            break
    return out


SO_PEERCRED = 17          # linux; who is on the other end, from the kernel


def peer_pid(conn: socket.socket) -> tuple[int, int]:
    """(pid, uid) of the process that opened the other end of this socket.
    It cannot be lied about: a plugin cannot name a different owner."""
    try:
        data = conn.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i"))
        pid, uid, _gid = struct.unpack("3i", data)
        return pid, uid
    except OSError:
        return 0, -1


def looks_like_escalation(argv: list[str]) -> bool:
    """Best-effort: does this argv look like a run at root (sudo, pkexec,
    su, doas) -- directly, through a shell script argument, or behind
    env/timeout-style pass-throughs? Pure heuristics over /proc cmdlines."""
    if not argv:
        return False
    base = os.path.basename(argv[0])
    if base in ROOT_LAUNCHERS:
        return True
    if base in SHELL_LAUNCHERS:
        for a in argv[1:]:
            for seg in re.split(r"[;&|\n]|\$\(", a):
                toks = seg.strip().split()
                if toks and os.path.basename(toks[0]) in ROOT_LAUNCHERS:
                    return True
        return False
    if base in PASS_THROUGH:
        for a in argv[1:]:
            if a.startswith("-") or ("=" in a and not a.startswith("/")):
                continue          # a flag, or VAR=value
            if os.path.basename(a) in ROOT_LAUNCHERS:
                return True
        return False
    if base == "timeout":
        past_duration = False
        for a in argv[1:]:
            if a.startswith("-"):
                continue
            if not past_duration:
                past_duration = True       # the first bare word is the duration
                continue
            # only the command position counts: `timeout 10 grep sudo file`
            # greps for a word; it does not run sudo
            return os.path.basename(a) in ROOT_LAUNCHERS
        return False
    return False


# ------------------------------------------------------- the sandbox set ----

def sandbox_builtins() -> set[str]:
    """Ids marked `sandbox: true` in Plugins.js (one plugin per line)."""
    ids: set[str] = set()
    try:
        for line in PLUGINS_JS.read_text(encoding="utf-8").splitlines():
            if "sandbox: true" in line:
                m = re.search(r'id:\s*"([^"]+)"', line)
                if m:
                    ids.add(m.group(1))
    except OSError:
        pass
    return ids


def sandbox_store() -> dict[str, str]:
    """Store plugins whose manifest group is background: {id: entry source}.
    A manifest that sits on a built-in's id is ignored (UserPlugins refuses
    it too; this is the second lock)."""
    builtin = set(builtin_sources())
    out: dict[str, str] = {}
    for mf in sorted(STORE_DIR.glob("*/plugin.json")):
        d = read_json(mf, None)
        if not isinstance(d, dict):
            continue
        pid, entry = d.get("id", ""), d.get("entry", "")
        if not pid or pid in builtin or "/" in entry or not (mf.parent / entry).is_file():
            continue
        group = d.get("group")
        if group in ("screen", "key"):
            continue  # has UI the shell must embed; keep it in-process
        out[pid] = str((mf.parent / entry).resolve())
    return out


def builtin_sources() -> dict[str, str]:
    """{id: absolute entry qml} for built-ins, from Plugins.js."""
    out: dict[str, str] = {}
    try:
        for line in PLUGINS_JS.read_text(encoding="utf-8").splitlines():
            m = re.search(r'\{\s*id:\s*"([^"]+)",\s*label:\s*"[^"]*",\s*source:\s*"([^"]+)"', line)
            if m:
                out[m.group(1)] = str((CONFIG_DIR / m.group(2)).resolve())
    except OSError:
        pass
    return out


def default_enabled() -> list[str]:
    """The enabledPlugins default from AequalynSettings.qml, parsed so the
    settings-file fallback (used only while the shell is down) matches it."""
    try:
        text = AEQUALYN_SETTINGS_QML.read_text(encoding="utf-8")
        m = re.search(r"property var enabledPlugins:\s*\[(.*?)\]", text, re.S)
        if m:
            return re.findall(r'"([^"]+)"', m.group(1))
    except OSError:
        pass
    return []


# --------------------------------------------------------------- settings ----

_last_enabled: list[str] | None = None


def enabled_from_settings() -> list[str]:
    """The enabledPlugins list, as the shell sees it. A missing `plugins` key
    means the default set (a fresh install); a file that cannot be read or
    parsed keeps what we last knew, so a corrupted or transiently unreadable
    settings file never looks like 'every plugin was turned off'."""
    global _last_enabled
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as f:
            d = json.load(f)
    except (OSError, ValueError):
        return _last_enabled if _last_enabled is not None else default_enabled()
    if isinstance(d, dict):
        v = d.get("plugins")
        if isinstance(v, list):
            _last_enabled = [str(x) for x in v]
            return _last_enabled
        if "plugins" not in d:          # valid file, key never written yet
            return default_enabled()
    return _last_enabled if _last_enabled is not None else default_enabled()


# ------------------------------------------------------------ host dirs ----

def ensure_host_dir(plugin_id: str) -> Path:
    """One QuickShell config per sandboxed plugin: shell.qml plus symlinks to
    the real config folders, so root:/ imports resolve as in the main shell.
    Rebuilt on every start; a moved config repairs itself."""
    d = HOSTS_DIR / plugin_id
    d.mkdir(parents=True, exist_ok=True)
    for name in HOST_LINKS:
        link = d / name
        target = CONFIG_DIR / name
        if not target.exists():
            continue
        if link.is_symlink() and os.readlink(link) == str(target):
            continue
        if link.is_symlink() or link.exists():
            link.unlink() if link.is_symlink() else shutil.rmtree(link, ignore_errors=True)
        link.symlink_to(target)
    for name in HOST_ROOT_FILES:
        link = d / name
        target = CONFIG_DIR / name
        if not target.exists():
            continue
        if link.is_symlink() and os.readlink(link) == str(target):
            continue
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(target)
    qml = d / "shell.qml"
    host_qml = CONFIG_DIR / "tools" / "watchdog" / "host" / "shell.qml"
    if not qml.is_symlink() or os.readlink(qml) != str(host_qml):
        if qml.is_symlink() or qml.exists():
            qml.unlink() if qml.is_symlink() else qml.unlink()
        qml.symlink_to(host_qml)
    # the host must not live-reload when the main config's files change;
    # only the main shell reloads (autoReload off also keeps a config edit
    # from bouncing every sandboxed process at once)
    qset = d / "quickshell.json"
    try:
        cur = read_json(qset, {})
        if cur.get("autoReload") is not False:
            with open(qset, "w", encoding="utf-8") as f:
                json.dump({"autoReload": False}, f)
    except OSError:
        pass
    return d


# ----------------------------------------------------------------- ram -----

def tree_rss_kb(pid: int, root_session: int | None = None) -> int:
    """RSS of a process and all its descendants, in KB (a plugin's `sh -c`
    helpers count against it). Reads /proc only; nothing is spawned.

    Detached consoles (setsid) are pruned when root_session is given, so a
    terminal the user opened does not count against the shell's budget."""
    if root_session is None:
        root_session = proc_session(pid)
    total, seen, stack = 0, set(), [pid]
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        if root_session is not None and proc_session(p) != root_session:
            continue
        try:
            with open(f"/proc/{p}/status", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("VmRSS:"):
                        total += int(line.split()[1])
                        break
            with open(f"/proc/{p}/task/{p}/children", encoding="utf-8") as f:
                stack.extend(int(x) for x in f.read().split())
        except (OSError, ValueError):
            continue
    return total

def proc_alive(pid: int) -> bool:
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
            return f.read().split(") ", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return False


def qs_processes() -> list[tuple[int, list[str]]]:
    """Every quickshell running, with its arguments."""
    out = []
    me = os.getpid()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == me:
            continue
        try:
            with open(entry / "cmdline", "rb") as f:
                args = f.read().decode("utf-8", "replace").split("\0")
        except OSError:
            continue
        if args and os.path.basename(args[0]) in ("qs", "quickshell"):
            out.append((pid, args))
    return out


def find_shell_pid() -> int | None:
    """A quickshell already running the main config (to adopt, never kill)."""
    for pid, args in qs_processes():
        # it must point at the main config dir, not at a sandbox host
        if any(str(CONFIG_DIR) in a for a in args) and not any("watchdog/hosts" in a for a in args):
            # never one of an ended session: it can no longer reach Hyprland
            if not of_ended_session(pid):
                return pid
    return None


def end_stale_shells() -> None:
    """Stop the main shells left from a Hyprland session that has ended: they cannot reach
    Hyprland, and while one runs, `qs -n` refuses to start this session's own."""
    stale = [pid for pid, args in qs_processes()
             if any(str(CONFIG_DIR) in a for a in args)
             and not any("watchdog/hosts" in a for a in args)
             and of_ended_session(pid)]
    for pid in stale:
        log(f"stopping a shell of an ended Hyprland session (pid {pid})")
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.time() + 4
    while time.time() < deadline and any(proc_alive(p) for p in stale):
        time.sleep(0.1)
    for pid in stale:
        if proc_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass


# ---------------------------------------------------------------- units ----

@dataclass
class Unit:
    name: str                       # "shell" or a plugin id
    kind: str                       # "shell" | "plugin"
    source: str = ""                # entry qml for plugins
    popen: subprocess.Popen | None = None
    pid: int = 0                    # for adopted units
    started_at: float = 0.0
    test_mode: str = ""             # "" | "leak" | "crash" (self-tests)
    ever_started: bool = False      # False until the first successful spawn
    hb_misses: int = 0
    ram_over: int = 0
    ram_kb: int = 0
    last_error: str = ""
    stopping: bool = False          # a stop we asked for: not a failure
    disabled_reason: str = ""
    planned: bool = False           # starting because of a planned restart
                                   # (restart-all, what an update calls):
                                   # demos that ask on enable stay quiet

    @property
    def alive(self) -> bool:
        if self.popen is not None:
            return self.popen.poll() is None
        return self.pid > 0 and proc_alive(self.pid)

    @property
    def current_pid(self) -> int:
        if self.popen is not None and self.popen.poll() is None:
            return self.popen.pid
        return self.pid if (self.popen is None and self.pid) else 0


class Supervisor:
    def __init__(self, conf: dict):
        self.conf = conf
        self.units: dict[str, Unit] = {}
        self.failures: dict[str, deque[float]] = {}
        self.next_start: dict[str, float] = {}
        self.disabled: dict[str, str] = {}     # id -> reason, until re-enabled
        self.settings_mtime = 0.0
        self.last_tick = time.monotonic()
        self.ram_at = 0.0
        self.store_mtime = -1.0
        self.hb_at = 0.0
        self.shutting_down = False
        self.listen: socket.socket | None = None
        # the escalation gate: requestId -> {event, decision, password, unit, what}
        self.esc_lock = threading.Lock()
        self.pending: dict[str, dict] = {}
        # commands that steer the supervisor, for its own loop: (conn, peer, req)
        self.commands: queue.Queue = queue.Queue()

    # ------------------------------------------------------------- utils --

    def budget_mb(self, unit: Unit) -> int:
        if unit.kind == "shell":
            return int(self.conf["shellRamMb"])
        by_id = self.conf.get("pluginRamMbById", {})
        return int(by_id.get(unit.name, self.conf["pluginRamMb"]))

    def failures_in_window(self, name: str) -> int:
        dq = self.failures.setdefault(name, deque())
        cutoff = time.time() - int(self.conf["crashWindowMinutes"]) * 60
        while dq and dq[0] < cutoff:
            dq.popleft()
        return len(dq)

    def record_failure(self, unit: Unit, kind: str, detail: str) -> None:
        self.failures.setdefault(unit.name, deque()).append(time.time())
        unit.last_error = f"{kind}: {detail}"
        log(f"failure {unit.name}: {unit.last_error}")
        n = self.failures_in_window(unit.name)
        if unit.kind == "shell":
            # the shell is the desktop: never turned off, just kept alive
            if n == int(self.conf["maxFailures"]):
                notify("Shell keeps failing",
                       f"The shell has failed {n} times in the last "
                       f"{self.conf['crashWindowMinutes']} minutes and is being restarted each time.\n"
                       + unit.last_error)
            return
        if n >= int(self.conf["maxFailures"]):
            self.disable_plugin(unit.name, f"it {kind} too many times "
                                           f"({n} in {self.conf['crashWindowMinutes']} min)")

    def backoff_seconds(self, name: str) -> float:
        n = max(self.failures_in_window(name), 1)
        return min(2.0 * (2 ** (n - 1)), float(self.conf["backoffMaxSeconds"]))

    # -------------------------------------------------------- settings ----

    def sync_no_sandbox(self) -> None:
        """Push watchdog.json's noSandbox list into the shell, so its in-process
        loader picks those plugins back up instead of waiting for the sandbox."""
        ids = json.dumps(list(self.conf.get("noSandbox", [])))
        if self.shell_ipc(["setNoSandbox", ids]):
            log(f"no-sandbox list pushed to the shell: {ids}")

    def sandbox_ids(self) -> set[str]:
        forced = set(self.conf.get("forceSandbox", []))
        no = set(self.conf.get("noSandbox", []))
        ids = (sandbox_builtins() | set(sandbox_store()) | forced) - no
        # a plugin the user turned off in settings is not supervised at all
        return {i for i in ids if i in set(enabled_from_settings())}

    def plugin_source(self, pid: str) -> str:
        stores = sandbox_store()
        if pid in stores:
            return stores[pid]
        return builtin_sources().get(pid, "")

    # ------------------------------------------------------- shell ipc ----

    def shell_ipc(self, args: list[str], timeout: float | None = 8) -> str | None:
        """Call the running shell's watchdog IPC target; None if it did not
        answer (down, starting, or hung)."""
        try:
            r = subprocess.run([QS_BIN, "ipc", "call", "watchdog", *args],
                               capture_output=True, text=True, timeout=timeout)
            if r.returncode == 0:
                return (r.stdout or "").strip() or ""
            return None
        except (OSError, subprocess.SubprocessError):
            return None

    def disable_plugin(self, pid: str, reason: str) -> None:
        """Turn a plugin off the same way the Plugins page does: through the
        shell's IPC (state + settings file stay in step). Only if the shell
        cannot be asked do we edit the file directly."""
        if pid in self.disabled:
            return
        self.disabled[pid] = reason
        unit = self.units.get(pid)
        if unit:
            unit.stopping = True
            self.stop_unit(unit, reason="disabled")
        label = pid
        out = self.shell_ipc(["health"])
        try:
            rows = json.loads(out).get("plugins", [])
            row = next((r for r in rows if r.get("id") == pid), None)
            if row and row.get("label"):
                label = row["label"]
        except (ValueError, AttributeError, TypeError):
            pass
        if self.shell_ipc(["disablePlugin", pid, reason]) is None:
            self.edit_settings_enabled(pid, enabled=False)
        notify("Plugin turned off",
               f"'{label}' was turned off: {reason}.\nThe rest of the shell is unaffected. "
               "Turn it back on in Settings \u2192 Plugins once it is fixed.")
        log(f"plugin {pid} disabled: {reason}")

    def kill_stray_hosts(self) -> None:
        """Host instances a previous watchdog left behind (a plain `stop` leaves
        them running): they still hold their configs, and qs -n then refuses
        every restart with a quiet exit 0. Hosts are stateless services, so
        they are stopped here and started again as needed right after."""
        # only hosts under this watchdog's own hosts folder: another watchdog's (a test's,
        # with its own state folder) are not ours to stop, and stopping them made this
        # session's plugins look as if they crashed, until they were turned off
        mine = str(HOSTS_DIR) + os.sep
        strays = [(pid, args) for pid, args in qs_processes()
                  if any(a.startswith(mine) for a in args)]
        if not strays:
            return
        for pid, _args in strays:
            log(f"stopping stray host instance pid {pid} from an earlier watchdog")
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        deadline = time.time() + 3
        while time.time() < deadline and any(proc_alive(p) for p, _ in strays):
            time.sleep(0.1)
        for pid, _ in strays:
            if proc_alive(pid):
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass

    def enable_plugin(self, pid: str) -> str:
        if pid not in self.disabled and pid in self.units:
            return "already running"
        self.disabled.pop(pid, None)
        # a fresh chance: the failure window and any pending restart go
        self.failures.pop(pid, None)
        self.next_start.pop(pid, None)
        answer = self.shell_ipc(["enablePlugin", pid])
        if answer is None:
            self.edit_settings_enabled(pid, enabled=True)
            return "ok"
        # the shell answered: pass on what it said (it knows its plugins)
        return answer or "ok"

    def edit_settings_enabled(self, pid: str, enabled: bool) -> None:
        """Fallback used only while the shell is down: move the id in the
        settings file itself, as the shell would."""
        d = read_json(SETTINGS_FILE, {})
        if not isinstance(d, dict):
            d = {}
        cur = d.get("plugins")
        cur = [str(x) for x in cur] if isinstance(cur, list) else default_enabled()
        if enabled and pid not in cur:
            cur.append(pid)
        if not enabled and pid in cur:
            cur.remove(pid)
        d["plugins"] = cur
        try:
            tmp = SETTINGS_FILE.with_suffix(".json.watchdog-tmp")
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(d, f, indent=2, ensure_ascii=False)
                f.write("\n")
            os.replace(tmp, SETTINGS_FILE)
            log(f"settings file edited directly ({'enabled' if enabled else 'disabled'} {pid})")
        except OSError as e:
            log(f"could not edit settings file: {e}")

    # ------------------------------------------------------- lifecycle ----

    def spawn(self, unit: Unit, adopt: bool = False) -> None:
        if unit.alive:
            return
        if adopt:
            end_stale_shells()
            pid = find_shell_pid()
            if pid:
                unit.pid, unit.popen = pid, None
                unit.started_at = time.time()
                unit.stopping = False
                unit.ever_started = True
                log(f"adopted running shell, pid {pid}")
                return
        logf = open(LOGS_DIR / f"{unit.name}.log", "ab", buffering=0)
        try:
            if unit.kind == "shell":
                args = [QS_BIN, "-n", "-p", str(CONFIG_DIR)]
                env = dict(os.environ)
            else:
                host = ensure_host_dir(unit.name)
                args = [QS_BIN, "-n", "-p", str(host)]
                env = dict(os.environ)
                env["AEQUALYN_PLUGIN_ID"] = unit.name
                env["AEQUALYN_PLUGIN_SOURCE"] = unit.source
                # each host registers with the portals as itself, instead of
                # fighting the main shell over the shared quickshell app id
                env["QS_APP_ID"] = "org.aequalyn.sandbox." + unit.name
                if unit.test_mode:
                    env["AEQUALYN_SANDBOX_TEST"] = unit.test_mode
                if unit.planned:
                    # a planned restart (restart-all, what an update calls):
                    # the plugin starts, but nothing user-facing asked for it
                    env["AEQUALYN_PLUGIN_PLANNED"] = "1"
            env["QS_NO_RELOAD_POPUP"] = "1"
            # children always start from $HOME, whatever directory the daemon
            # itself was started from: an update replaces the config folder
            # (rm -rf + mv), and a child spawned with a cwd inside it is born
            # with a deleted working directory -- half-broken, in ways a
            # heartbeat cannot see
            unit.popen = subprocess.Popen(args, stdout=logf, stderr=subprocess.STDOUT, env=env,
                                          cwd=str(Path.home()), umask=CHILD_UMASK)
            unit.pid = 0
            unit.started_at = time.time()
            unit.ever_started = True
            unit.stopping = False
            unit.planned = False      # the env was set for this start only
            unit.hb_misses = unit.ram_over = 0
            log(f"started {unit.name} (pid {unit.popen.pid})")
        except OSError as e:
            log(f"could not start {unit.name}: {e}")
            self.record_failure(unit, "start-failed", str(e))
            self.schedule_restart(unit)
        finally:
            logf.close()

    def stop_unit(self, unit: Unit, reason: str = "") -> None:
        if not unit.alive:
            return
        unit.stopping = True
        pid = unit.current_pid
        log(f"stopping {unit.name} (pid {pid}){': ' + reason if reason else ''}")
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + 4
        while time.time() < deadline and unit.alive:
            time.sleep(0.1)
        if unit.alive:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        unit.hb_misses = unit.ram_over = 0

    # -------------------------------------------------------- policies ----

    def reap(self) -> None:
        for unit in list(self.units.values()):
            if not unit.ever_started:
                continue          # waiting for its first spawn: not dead, not up
            if unit.name in self.next_start:
                continue          # already down; a restart is scheduled, don't double-count
            if unit.alive:
                continue
            code = unit.popen.poll() if unit.popen is not None else None
            unit.pid = 0
            unit.ever_started = False
            if unit.stopping:
                unit.stopping = False
                log(f"{unit.name} stopped as asked (exit {code})")
                continue
            if unit.kind == "shell" and code == 0:
                # a qs -n that refuses a duplicate exits 0 the moment another
                # shell holds the config: if one is really out there, the
                # desktop is being served by a shell started outside us
                # (a fallback that won the boot race) -- adopt it instead of
                # crash-looping against it, so the desktop is supervised
                # again and the root gate works.
                outside = find_shell_pid()
                if outside:
                    unit.pid, unit.popen = outside, None
                    unit.started_at = time.time()
                    unit.stopping = False
                    unit.ever_started = True
                    unit.hb_misses = unit.ram_over = 0
                    log(f"adopted the running shell, pid {outside} "
                        f"(our own spawn had refused its duplicate)")
                    continue
            detail = f"exit code {code}" if code is not None else "process gone"
            self.record_failure(unit, "crashed", detail)
            self.schedule_restart(unit)

    def schedule_restart(self, unit: Unit) -> None:
        if unit.name in self.disabled:
            return
        delay = self.backoff_seconds(unit.name)
        self.next_start[unit.name] = time.time() + delay
        log(f"{unit.name} restarting in {delay:.0f}s")

    def start_due(self) -> None:
        now = time.time()
        for name, at in list(self.next_start.items()):
            if at > now:
                continue
            del self.next_start[name]
            unit = self.units.get(name)
            if unit and not unit.alive and name not in self.disabled:
                self.spawn(unit)

    def check_ram(self) -> None:
        for unit in list(self.units.values()):
            if not unit.alive:
                unit.ram_over = 0
                continue
            pid = unit.current_pid
            if not pid:
                continue
            unit.ram_kb = tree_rss_kb(pid, proc_session(pid))
            budget = self.budget_mb(unit) * 1024
            if unit.ram_kb > budget:
                unit.ram_over += 1
                # a gross overrun (>= 2x budget) is a breach on one sample:
                # a runaway allocator is stopped within one sampling period
                # instead of filling gigabytes while samples accumulate
                gross = unit.ram_kb >= budget * 2
                log(f"{unit.name} over budget: {unit.ram_kb // 1024} MiB > {budget // 1024} MiB "
                    f"(sample {unit.ram_over}/{int(self.conf['ramBreachSamples'])}"
                    + (", gross" if gross else "") + ")")
                if gross or unit.ram_over >= int(self.conf["ramBreachSamples"]):
                    self.stop_unit(unit, "memory budget exceeded")
                    self.record_failure(unit, "used too much memory",
                                         f"{unit.ram_kb // 1024} MiB RSS")
                    self.schedule_restart(unit)
            else:
                unit.ram_over = 0

    def check_heartbeats(self) -> None:
        grace = float(self.conf["heartbeatGraceSeconds"])
        timeout = float(self.conf["heartbeatTimeoutSeconds"])
        for unit in list(self.units.values()):
            if not unit.alive or time.time() - unit.started_at < grace:
                unit.hb_misses = 0
                continue
            pid = unit.current_pid
            if not pid:
                continue
            try:
                if unit.kind == "shell":
                    args = [QS_BIN, "ipc", "call", "watchdog", "ping"]
                else:
                    args = [QS_BIN, "ipc", "--pid", str(pid), "call", "sandbox", "ping"]
                r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
                ok = r.returncode == 0 and "ok" in (r.stdout or "")
            except subprocess.TimeoutExpired:
                ok = False
            except (OSError, subprocess.SubprocessError):
                continue
            if ok:
                unit.hb_misses = 0
                continue
            unit.hb_misses += 1
            log(f"{unit.name} heartbeat missed ({unit.hb_misses}/2)")
            if unit.hb_misses >= 2:
                self.stop_unit(unit, "heartbeat unanswered")
                self.record_failure(unit, "stopped answering", "its event loop was blocked")
                self.schedule_restart(unit)

    # ------------------------------------------------------ settings sync --

    def sync_units(self) -> None:
        """enabledPlugins is the single source of truth, wherever it was
        changed (Settings page, CLI, an automatic turn-off): follow it. The
        Store directory is watched too, so a plugin installed or removed while
        the shell is down (or while its own settings are untouched) is still
        picked up on the next scan."""
        try:
            mtime = SETTINGS_FILE.stat().st_mtime if SETTINGS_FILE.exists() else 0.0
        except OSError:
            mtime = 0.0
        try:
            stime = STORE_DIR.stat().st_mtime if STORE_DIR.exists() else 0.0
        except OSError:
            stime = 0.0
        if mtime == self.settings_mtime and stime == self.store_mtime:
            return
        self.settings_mtime = mtime
        self.store_mtime = stime
        wanted = self.sandbox_ids()
        changed = False
        # drop units that were turned off or un-sandboxed
        for name in list(self.units):
            if name == "shell":
                continue
            if name not in wanted:
                unit = self.units.pop(name)
                self.next_start.pop(name, None)
                if unit.alive:
                    self.stop_unit(unit, "off in settings")
                    changed = True
                log(f"stopped supervising {name}: off in settings")
        # pick up newly enabled sandboxed plugins
        for pid in sorted(wanted):
            if pid in self.units:
                continue
            # it was turned off by the watchdog and is enabled again in
            # settings: that is a person giving it another chance (the toggle
            # may have come from the Settings page, not our CLI), so the
            # disable note and the failure window are stale
            if pid in self.disabled:
                self.disabled.pop(pid, None)
                self.failures.pop(pid, None)
                log(f"{pid} enabled again in settings: watching it once more")
            source = self.plugin_source(pid)
            if not source:
                log(f"cannot sandbox {pid}: no entry file found")
                continue
            self.units[pid] = Unit(name=pid, kind="plugin", source=source)
            self.next_start[pid] = time.time()  # start on the next tick
            changed = True
        if changed:
            log(f"supervising: shell + {sorted(u for u in self.units if u != 'shell')}")

    # ------------------------------------------------------------ socket --

    def open_socket(self) -> None:
        try:
            if SOCK_PATH.exists():
                SOCK_PATH.unlink()
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.bind(str(SOCK_PATH))
            os.chmod(SOCK_PATH, 0o600)
            s.listen(32)
            self.listen = s
            threading.Thread(target=self.serve_socket, daemon=True).start()
        except OSError as e:
            log(f"could not open control socket: {e}")
            self.listen = None

    def serve_socket(self) -> None:
        """Takes every caller in at once, on a thread of its own: the loop may be busy for
        seconds (a shell that does not answer, a unit being stopped), and neither a root
        request nor its answer may wait for that, let alone be told nobody is there."""
        while not self.shutting_down and self.listen is not None:
            try:
                conn, _ = self.listen.accept()
            except OSError as e:
                if e.errno in (errno.EINTR, errno.ECONNABORTED):
                    continue
                return
            threading.Thread(target=self.serve_caller, args=(conn,), daemon=True).start()

    def serve_caller(self, conn: socket.socket) -> None:
        try:
            # who it is, before anything else: by the time it is answered its parents may be gone
            peer = peer_pid(conn)
            unit = self.unit_of_caller(peer)
            conn.settimeout(5)
            data = b""
            while b"\n" not in data:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            req = json.loads(data.decode("utf-8", "replace") or "{}")
            cmd = req.get("cmd")
            if cmd == "exec-root":
                self.handle_exec_root(conn, peer, req, unit)
            elif cmd in ("decide", "status"):
                self.esc_reply(conn, self.handle(conn, req, peer))
            else:
                # starts and stops things: the loop's own work
                self.commands.put((conn, peer, req))
        except (OSError, ValueError, AttributeError) as e:
            self.esc_reply(conn, {"ok": False, "error": f"bad request: {e}"})

    def run_commands(self) -> None:
        while True:
            try:
                conn, peer, req = self.commands.get_nowait()
            except queue.Empty:
                return
            try:
                reply = self.handle(conn, req, peer)
            except (OSError, ValueError) as e:
                reply = {"ok": False, "error": f"bad request: {e}"}
            self.esc_reply(conn, reply)

    def unit_of_caller(self, peer: tuple[int, int]) -> Unit | None:
        """Which supervised unit the socket caller belongs to, by its real
        process chain (SO_PEERCRED + /proc): a plugin cannot claim to be
        another one. None = not one of ours (a terminal, an orphan)."""
        pid, uid = peer
        if uid != os.getuid() or pid <= 0:
            return None
        chain = set(ancestors(pid))
        for unit in list(self.units.values()):
            if unit.current_pid and unit.current_pid in chain:
                return unit
        return None

    # ---------------------------------------------------- the root gate --

    def esc_reply(self, conn: socket.socket, reply: dict) -> None:
        try:
            conn.settimeout(None)
            conn.sendall((json.dumps(reply) + "\n").encode("utf-8"))
        except OSError:
            pass
        try:
            conn.close()
        except OSError:
            pass

    def label_of(self, pid: str) -> str:
        """What the shell calls this plugin, for the window and the logs."""
        out = self.shell_ipc(["health"])
        try:
            rows = json.loads(out).get("plugins", [])
            for r in rows:
                if r.get("id") == pid and r.get("label"):
                    return str(r["label"])
        except (ValueError, AttributeError, TypeError):
            pass
        return pid

    def caller_unit(self, peer: tuple[int, int]) -> Unit | None:
        """The caller's unit. A shell that was started outside the supervisor (a login's
        fallback) is taken over within a few seconds: its requests wait for that."""
        until = time.monotonic() + 20
        while True:
            unit = self.unit_of_caller(peer)
            if unit is not None or time.monotonic() > until:
                return unit
            if peer[1] != os.getuid() or find_shell_pid() not in ancestors(peer[0]):
                return None
            time.sleep(0.5)

    def shell_pid(self) -> int:
        unit = self.units.get("shell")
        return unit.current_pid if unit and unit.alive else 0

    def ask_shell(self, payload: str, wait: float = 45) -> int:
        """Has the shell open the approval window: the pid that was asked, 0 when none
        answered. A shell that is starting (a login, a restart) is waited for."""
        until = time.monotonic() + wait
        while True:
            pid = self.shell_pid()
            if pid and self.shell_ipc(["escalationRequest", payload]) is not None:
                return pid
            if time.monotonic() > until or self.shutting_down:
                return 0
            time.sleep(0.5)

    def withdraw(self, rid: str, why: str) -> None:
        with self.esc_lock:
            self.pending.pop(rid, None)
        log(f"escalation {rid}: {why}")
        self.shell_ipc(["escalationGone", rid], timeout=3)

    @staticmethod
    def hung_up(conn: socket.socket) -> bool:
        """Is the one who asked gone? (It sends its request, then only waits.)"""
        try:
            conn.setblocking(False)
            return conn.recv(1, socket.MSG_PEEK) == b""
        except (BlockingIOError, InterruptedError):
            return False
        except OSError:
            return True

    def handle_exec_root(self, conn: socket.socket, peer: tuple[int, int], req: dict,
                         unit: Unit | None = None) -> None:
        """The whole escalation flow, on its own thread (it waits out the
        approval window). The argv that runs is pinned in the plugin's
        manifest; the caller is pinned by its process; the user is asked
        through the shell's window; the password goes to sudo on stdin."""
        args = req.get("args", [])
        claim = str(args[0]) if args else ""       # only used by in-process built-ins
        action_id = str(args[1]) if len(args) > 1 else ""
        try:
            unit = unit or self.caller_unit(peer)
            if unit is None:
                self.esc_reply(conn, {"ok": False,
                    "error": "not a supervised process: the gate is for plugins "
                             "(a terminal already has sudo)"})
                return
            if unit.kind == "plugin":
                plugin_id = unit.name          # the kernel says who is asking
            else:
                # the shell unit is one process: an in-process built-in names
                # itself, and that is trusted the same way all shell code is
                plugin_id = claim
                if not plugin_id or not builtin_root_actions().get(plugin_id):
                    self.esc_reply(conn, {"ok": False,
                        "error": "no built-in declares root actions"})
                    return
            actions = root_actions_of(plugin_id)
            act = next((a for a in actions if a["id"] == action_id), None)
            if act is None:
                self.esc_reply(conn, {"ok": False,
                    "error": f"'{plugin_id}' declares no root action '{action_id}' "
                             "(the command must be pinned in the manifest, not passed in)"})
                return
            if act["quiet"]:
                out = self.run_quiet(act["command"])
                if out is not None:
                    log(f"'{plugin_id}' ran '{' '.join(act['command'])}' without asking, as the rules allow, "
                        f"exit {out['code']}")
                    self.esc_reply(conn, {"ok": out["code"] == 0, **out})
                    return
            # one pending request per plugin: it cannot stack windows until someone
            # clicks Allow in a hurry. The shell's own built-ins share one process, so
            # theirs is one per action: the browsers' colour, asked for by itself at
            # login, must not stand in the way of the installer
            what = unit.name if unit.kind == "plugin" else f"{plugin_id}/{action_id}"
            with self.esc_lock:
                if any(p["what"] == what for p in self.pending.values()):
                    rid = ""
                else:
                    rid = f"{time.time_ns():x}-{secrets.token_hex(4)}"
                    pend = {"unit": unit.name, "what": what, "event": threading.Event(),
                            "decision": "", "password": ""}
                    self.pending[rid] = pend
            if not rid:
                # the reply is sent outside the lock: socket IO must never
                # hold up the supervisor (a stuck client would otherwise
                # freeze every decide coming in)
                self.esc_reply(conn, {"ok": False,
                    "error": "another root request from this plugin is already waiting"})
                return
            try:
                self.escalate(conn, rid, pend, plugin_id, act)
            finally:
                with self.esc_lock:
                    self.pending.pop(rid, None)
        except Exception as e:              # never take the daemon down
            log(f"escalation flow failed: {e!r}")
            self.esc_reply(conn, {"ok": False, "error": f"internal error: {e}"})

    # The Store's package actions run one fixed command, but what it installs is the list
    # the Store staged. The window shows that list, and root gets its sha256 so a list
    # changed after the person saw it is refused (aequalyn-store gate-pkg --expect).
    STORE_PKG = {"pkg-install": "install", "pkg-remove": "remove"}
    PKG_NAME_RE = re.compile(r"^[A-Za-z0-9@_+][A-Za-z0-9@._+-]{0,127}$")

    def staged_packages(self, act: dict) -> tuple[list[str], str] | str:
        """(the argv to run, what the window shows), or why the request is refused."""
        stage = Path.home() / ".local" / "state" / "aequalyn" / "gate" / "pkg.json"
        try:
            raw = stage.read_bytes()
            d = json.loads(raw)
        except (OSError, ValueError):
            return "the staged packages could not be read"
        names = d.get("packages") if isinstance(d, dict) else None
        if d.get("op") != self.STORE_PKG[act["id"]] or not isinstance(names, list) \
                or not 1 <= len(names) <= 32 or not all(isinstance(n, str) and self.PKG_NAME_RE.match(n) for n in names):
            return "the staged packages are not a valid request"
        pacman = "pacman -S --needed --noconfirm" if d["op"] == "install" else "pacman -Rns --noconfirm"
        return (act["command"] + ["--expect", hashlib.sha256(raw).hexdigest()],
                pacman + " -- " + " ".join(names))

    def escalate(self, conn: socket.socket, rid: str, pend: dict, plugin_id: str, act: dict) -> None:
        action_id = act["id"]
        cmd_text = " ".join(act["command"])
        if plugin_id == "store" and action_id in self.STORE_PKG:
            staged = self.staged_packages(act)
            if isinstance(staged, str):
                log(f"escalation {rid}: refused, {staged}")
                self.esc_reply(conn, {"ok": False, "error": staged})
                return
            act = dict(act, command=staged[0])
            cmd_text = staged[1]
        log(f"escalation {rid}: '{plugin_id}' asks to run as root: {cmd_text}")
        payload = json.dumps({
            "requestId": rid, "plugin": plugin_id,
            "label": self.label_of(plugin_id),
            "version": self.store_version(plugin_id),
            "source": "store" if (STORE_DIR / plugin_id / "plugin.json").is_file() else "built-in",
            "action": action_id, "actionLabel": act["label"],
            "command": cmd_text, "about": act["about"], "interactive": act["interactive"],
            "allowed": action_id in allowed_root().get(plugin_id, set()),
        })
        wait = float(self.conf["escalationTimeoutSeconds"])
        asked = self.ask_shell(payload)
        until = time.monotonic() + wait
        while asked and not pend["event"].wait(timeout=0.5):
            if self.hung_up(conn):
                self.withdraw(rid, "taken back: whoever asked is gone")
                self.esc_reply(conn, {"ok": False, "error": "taken back"})
                return
            if time.monotonic() > until:
                self.withdraw(rid, "denied by timeout")
                self.esc_reply(conn, {"ok": False, "error": "denied: no answer in time"})
                return
            # the shell was restarted, and its window went with it: ask the new one
            if self.shell_pid() != asked:
                log(f"escalation {rid}: the shell was restarted, asking again")
                asked = self.ask_shell(payload)
                until = time.monotonic() + wait
        if not asked and not pend["event"].is_set():
            log(f"escalation {rid}: denied -- the shell could not be reached to ask")
            self.esc_reply(conn, {"ok": False,
                "error": "the shell could not be reached, so no one could approve"})
            return
        with self.esc_lock:
            self.pending.pop(rid, None)
        if pend["decision"] == "deny":
            log(f"escalation {rid}: denied by the user")
            self.esc_reply(conn, {"ok": False, "error": "denied by the user"})
            return
        if pend["decision"] == "always":
            # consent remembered; the window still opens next time,
            # because sudo still needs the password
            log(f"escalation {rid}: allowed, always, for '{action_id}'")
        else:
            log(f"escalation {rid}: allowed once")
        if act["interactive"]:
            out = self.run_interactive(act["command"], pend["password"], rid)
        else:
            out = self.run_sanctioned(act["command"], pend["password"])
        log(f"escalation {rid}: ran '{cmd_text}', "
            + ("still running" if out.get("started") else f"exit {out.get('code')}"))
        self.esc_reply(conn, {"ok": out.get("code") == 0, **out})

    def store_version(self, pid: str) -> str:
        d = read_json(STORE_DIR / pid / "plugin.json", None)
        return str(d.get("version", "")) if isinstance(d, dict) else ""

    def run_quiet(self, argv: list[str]) -> dict | None:
        """The same without a password, where the rules have it so; None where they do not."""
        try:
            r = subprocess.run(["sudo", "-n", "--"] + argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               env=dict(os.environ, LC_ALL="C"), start_new_session=True, umask=CHILD_UMASK,
                               timeout=int(self.conf["escalationCommandTimeoutSeconds"]))
        except (OSError, subprocess.SubprocessError):
            return None
        if r.returncode != 0 and r.stderr.lstrip().startswith("sudo:"):
            return None                  # sudo said no, not the command
        return {"code": r.returncode, "out": (r.stdout or "")[:4096], "err": (r.stderr or "")[:4096]}

    def run_interactive(self, argv: list[str], password: str, rid: str) -> dict:
        """The same for a program a person stays in (the installer): told apart from one
        that could not start, a wrong password say, by still being there after a moment,
        and then left alone, with no time limit. What it says goes to a log."""
        path = LOGS_DIR / f"root-{os.path.basename(argv[0])}.log"
        try:
            with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as logf:
                proc = subprocess.Popen(["sudo", "-S", "-p", "", "--"] + argv, stdin=subprocess.PIPE,
                                        stdout=logf, stderr=subprocess.STDOUT, start_new_session=True,
                                        umask=CHILD_UMASK)
        except OSError as e:
            return {"code": 127, "out": "", "err": f"could not run sudo: {e}"}
        try:
            proc.stdin.write(((password or "") + "\n").encode("utf-8"))
            proc.stdin.close()
        except (OSError, ValueError):
            pass                         # sudo may not even need a password
        try:
            code = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            def reap() -> None:
                log(f"escalation {rid}: '{argv[0]}' ended, exit {proc.wait()}")
            threading.Thread(target=reap, daemon=True).start()
            return {"code": 0, "started": True, "out": "", "err": ""}
        try:
            said = path.read_text(encoding="utf-8", errors="replace")[-4096:]
        except OSError:
            said = ""
        return {"code": code, "out": "", "err": said}

    def run_sanctioned(self, argv: list[str], password: str) -> dict:
        """The one place root is ever handed out: `sudo -S` with the
        password on stdin (never argv), a timeout, and the command pinned
        in the manifest. Runs as a child of the daemon, never of a unit,
        so the escalation scan never sees its own sanctioned runs."""
        try:
            proc = subprocess.Popen(
                ["sudo", "-S", "-p", "", "--"] + argv,
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True, start_new_session=True, umask=CHILD_UMASK)
        except OSError as e:
            return {"code": 127, "out": "", "err": f"could not run sudo: {e}"}
        try:
            try:
                proc.stdin.write((password or "") + "\n")
                proc.stdin.flush()
            except (OSError, ValueError):
                pass                     # sudo may not even need a password
            try:
                proc.stdin.close()
            except OSError:
                pass
            out, err = proc.communicate(
                timeout=int(self.conf["escalationCommandTimeoutSeconds"]))
        except subprocess.TimeoutExpired:
            kill_tree(proc.pid)
            proc.wait()
            return {"code": 124, "out": "", "err": "the root command timed out"}
        if proc.returncode == 1 and "usual lecture" in (err or ""):
            # the account's very first sudo: the lecture ("We trust you...")
            # breaks sudo's piped-password read with no tty, and the command
            # never ran. Say so, instead of dumping the banner at whoever
            # reads the reply.
            return {"code": 1, "out": "", "err":
                    "this is the account's first sudo, and its lecture "
                    "breaks the password pipe -- run any command with sudo "
                    "once in a terminal (it shows the lecture), then ask "
                    "again. On the live ISO the lecture is off by design."}
        return {"code": proc.returncode,
                "out": (out or "")[:4096], "err": (err or "")[:4096]}

    def check_escalations(self) -> None:
        """Level 2: anything under a supervised unit that looks like a run
        at root (sudo, pkexec, su, doas) and is not the gate itself. The
        gate's own sudo is a child of the daemon, so it is never in a
        unit's tree: every hit here went around the gate."""
        for unit in list(self.units.values()):
            if not unit.alive:
                continue
            pid = unit.current_pid
            if not pid:
                continue
            for epid, eargv in tree_processes(pid, root_session=proc_session(pid)):
                if not looks_like_escalation(eargv):
                    continue
                cmd = " ".join(eargv)[:300]
                kill_tree(epid)
                log(f"{unit.name} tried to run as root outside the gate: {cmd}")
                if unit.kind == "shell":
                    notify("The shell tried to run as root",
                           f"Something inside the shell started:\n  {cmd}\n"
                           "It was stopped. First-party flows go through the gate "
                           "now, so this is either a leftover or something to look "
                           "into -- check what changed in your shell.")
                else:
                    n = self.failures_in_window(unit.name) + 1
                    notify("Plugin stopped: it tried to run as root",
                           f"'{self.label_of(unit.name)}' started:\n  {cmd}\n"
                           "It was stopped. A plugin must declare its root actions "
                           f"(needsRoot) and go through the approval window. "
                           f"Attempt {n} of {int(self.conf['maxFailures'])}; after "
                           "that it is turned off.")
                self.record_failure(unit, "tried to run as root", cmd)
                break          # one finding per unit per scan is enough

    # ------------------------------------------------------------ socket --

    def handle(self, conn: socket.socket, req: dict, peer: tuple[int, int]) -> dict:
        cmd = str(req.get("cmd", ""))
        args = req.get("args", [])
        # plugins may not steer the supervisor itself: a unit's process may
        # only ever ask for escalations (exec-root) and read status. The
        # shell unit may -- its code is ours.
        if cmd in ("restart", "restart-all", "enable", "disable", "test", "stop-daemon"):
            unit = self.unit_of_caller(peer)
            if unit is not None and unit.kind == "plugin":
                return {"ok": False,
                        "error": "a plugin cannot control the supervisor "
                                 "(only request escalations)"}
        if cmd == "decide":
            # only the shell's window may answer: the decide CLI is its
            # child, so the peer resolves to the shell unit. A plugin asking
            # for root can never approve its own request, and neither can a
            # stranger who guesses the id.
            unit = self.unit_of_caller(peer)
            if unit is None or unit.kind != "shell":
                return {"ok": False,
                        "error": "only the shell's approval window may answer"}
            rid = str(args[0]) if args else ""
            decision = str(args[1]) if len(args) > 1 else ""
            if decision not in ("once", "always", "deny"):
                return {"ok": False, "error": "decision must be once, always or deny"}
            with self.esc_lock:
                pend = self.pending.get(rid)
                if pend is None:
                    return {"ok": False, "error": "no such pending request (answered or timed out)"}
                pend["decision"] = decision
                # the password rides the socket only (uid-checked above,
                # mode 0600); it is never logged and never in argv
                pend["password"] = str(req.get("password", ""))[:256] if decision != "deny" else ""
                pend["event"].set()
            return {"ok": True}
        if cmd == "status":
            return {"ok": True, **self.status()}
        if cmd == "list":
            rows = []
            for unit in self.units.values():
                rows.append({
                    "id": unit.name, "kind": unit.kind,
                    "running": unit.alive,
                    "pid": unit.current_pid,
                    "uptime": int(time.time() - unit.started_at) if unit.alive else 0,
                    "rssMiB": round(unit.ram_kb / 1024, 1),
                    "budgetMiB": self.budget_mb(unit),
                    "failures": self.failures_in_window(unit.name),
                    "error": unit.last_error, "test": unit.test_mode,
                })
            return {"ok": True, "units": rows,
                    "disabled": {k: v for k, v in self.disabled.items()},
                    "sandboxed": sorted(self.sandbox_ids())}
        if cmd == "restart":
            who = str(args[0]) if args else "shell"
            if who == "shell":
                unit = self.units.get("shell")
                if unit:
                    self.stop_unit(unit, "restarted by hand")
                    unit.stopping = False
                    self.spawn(unit)
                    return {"ok": True, "restarted": "shell"}
                return {"ok": False, "error": "no shell unit"}
            unit = self.units.get(who)
            if unit:
                self.failures.pop(who, None)
                self.next_start.pop(who, None)
                unit.test_mode = ""      # a restart by hand means back to normal
                self.stop_unit(unit, "restarted by hand")
                unit.stopping = False
                self.spawn(unit)
                return {"ok": True, "restarted": who}
            return {"ok": False, "error": f"{who} is not supervised "
                                           "(enabled? sandboxed?)"}
        if cmd == "restart-all":
            # a planned restart, the way an update uses it: shell and every
            # sandboxed plugin stop and start fresh, none of it counted as
            # failure, and the failure windows start over. The plugin starts
            # are marked planned: a demo that asks for root when it is
            # turned on stays quiet when an update merely restarts it.
            for name in list(self.units):
                self.failures.pop(name, None)
                self.next_start.pop(name, None)
                unit = self.units[name]
                unit.test_mode = ""
                if unit.kind == "plugin":
                    unit.planned = True
                self.stop_unit(unit, "planned restart")
                unit.stopping = False
            for unit in self.units.values():
                self.spawn(unit)
            log("planned restart of everything (restart-all)")
            return {"ok": True, "restarted": sorted(self.units)}
        if cmd == "enable":
            pid = str(args[0]) if args else ""
            if not pid:
                return {"ok": False, "error": "which plugin?"}
            return {"ok": True, "result": self.enable_plugin(pid)}
        if cmd == "disable":
            pid = str(args[0]) if args else ""
            if not pid:
                return {"ok": False, "error": "which plugin?"}
            self.disable_plugin(pid, str(args[1]) if len(args) > 1 else "turned off by hand")
            return {"ok": True, "disabled": pid}
        if cmd == "test":
            pid, mode = (str(args[0]) if args else ""), (str(args[1]) if len(args) > 1 else "")
            unit = self.units.get(pid)
            if not unit or unit.kind != "plugin":
                return {"ok": False, "error": f"{pid} is not a sandboxed plugin"}
            if mode not in ("", "leak", "hang", "crash", "esc"):
                return {"ok": False, "error": "test mode must be leak, hang, crash or esc"}
            unit.test_mode = mode
            self.stop_unit(unit, "test restart")
            unit.stopping = False
            self.failures.pop(pid, None)
            self.spawn(unit)
            return {"ok": True, "plugin": pid, "test": mode}
        if cmd == "stop-daemon":
            kill_children = bool(args and args[0])
            self.shutting_down = True
            if kill_children:
                for unit in self.units.values():
                    self.stop_unit(unit, "watchdog stopping")
            # a deliberate stop says so, so `ensure` (the shell's keep-alive)
            # does not bring the supervisor straight back
            try:
                STOP_MARKER.write_text(str(os.getpid()) + "\n")
            except OSError:
                pass
            return {"ok": True, "killed-children": kill_children}
        return {"ok": False, "error": f"unknown command {cmd!r}"}

    def status(self) -> dict:
        shell = self.units.get("shell")
        return {
            "running": True,
            "pid": os.getpid(),
            "hyprland": HYPR_SIG,
            "shell": {"running": bool(shell and shell.alive),
                      "pid": shell.current_pid if shell else None,
                      "rssMiB": round(shell.ram_kb / 1024, 1) if shell else 0,
                      "budgetMiB": self.conf["shellRamMb"],
                      "failures": self.failures_in_window("shell")},
            "plugins": [{"id": u.name, "running": u.alive, "pid": u.current_pid,
                         "rssMiB": round(u.ram_kb / 1024, 1),
                         "budgetMiB": self.budget_mb(u),
                         "failures": self.failures_in_window(u.name),
                         "test": u.test_mode}
                        for u in list(self.units.values()) if u.kind == "plugin"],
            "disabled": dict(self.disabled),
            "sandboxed": sorted(self.sandbox_ids()),
            "escalations": {rid: {"unit": p["unit"]}
                            for rid, p in list(self.pending.items())},
        }

    # ------------------------------------------------------------ main ----

    def run(self, adopt: bool) -> None:
        # never sit in a directory an update might delete (the config folder);
        # children inherit this, so it has to be somewhere permanent
        try:
            os.chdir(str(Path.home()))
        except OSError:
            pass
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LOGS_DIR.mkdir(parents=True, exist_ok=True)
        HOSTS_DIR.mkdir(parents=True, exist_ok=True)
        log(f"aequalyn-watchdog starting (pid {os.getpid()}), qs={QS_BIN}, config={CONFIG_DIR}")
        try:
            if STOP_MARKER.exists():
                STOP_MARKER.unlink()
        except OSError:
            pass
        # The socket opens FIRST, before the shell is spawned and the strays
        # are cleaned: `start` only reports success once the supervisor can
        # actually be reached, and a slow machine (a live ISO on squashfs, a
        # cold VM) must not make the caller give up waiting while the daemon
        # is still on its way -- that is how an unsupervised fallback shell
        # once raced the supervisor to the desktop and the gate refused
        # everything (the crash loop looked like `qs -n` refusing a
        # duplicate, exit code 0, forever).
        self.units["shell"] = Unit(name="shell", kind="shell")
        self.open_socket()
        self.spawn(self.units["shell"], adopt=adopt)
        self.kill_stray_hosts()
        self.settings_mtime = -1.0   # force the first sync
        self.store_mtime = -1.0
        self.sync_no_sandbox()

        def on_term(_sig, _frm):
            self.shutting_down = True
        signal.signal(signal.SIGTERM, on_term)
        signal.signal(signal.SIGINT, on_term)

        next_ram = time.monotonic() + 5
        next_hb = time.monotonic() + float(self.conf["heartbeatSeconds"])
        ram_every = max(2, int(self.conf["ramCheckSeconds"]))
        hb_every = max(5, float(self.conf["heartbeatSeconds"]))

        gone = 0
        while not self.shutting_down:
            time.sleep(1.0)
            # its Hyprland session ended (a logout): leave with what it started, so the next
            # session gets a supervisor of its own. Three seconds in a row, never one glance
            gone = 0 if hyprland_alive(HYPR_SIG) else gone + 1
            if gone >= 3:
                log("its Hyprland session has ended: stopping, with what it started")
                self.shutting_down = True
                for unit in list(self.units.values()):
                    self.stop_unit(unit, "Hyprland session ended")
                break
            self.reap()
            self.start_due()
            self.sync_units()
            self.run_commands()
            now = time.monotonic()
            if now >= next_ram:
                self.check_ram()
                self.check_escalations()
                next_ram = now + ram_every
            if now >= next_hb:
                self.check_heartbeats()
                next_hb = now + hb_every
        log("watchdog stopping (supervised processes are left running)")
        try:
            if SOCK_PATH.exists():
                SOCK_PATH.unlink()
            if PID_FILE.exists():
                PID_FILE.unlink()
        except OSError:
            pass


# ------------------------------------------------------------------ cli ----

def send_to_daemon(req: dict, timeout: float = 20) -> dict:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(str(SOCK_PATH))
    try:
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.decode("utf-8", "replace").strip() or "{}")
    finally:
        s.close()


def daemon_alive() -> bool:
    if not SOCK_PATH.exists():
        return False
    try:
        return send_to_daemon({"cmd": "status"}, timeout=3).get("ok", False)
    except (OSError, ValueError):
        return False


def take_lock():
    """The one lock a supervisor holds for as long as it lives (the kernel drops it
    with the process): an open file, or None while another supervisor has it."""
    f = open(LOCK_FILE, "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


def supervisor_there() -> bool:
    """Is there a supervisor? One too busy to answer still holds the lock: a machine
    under load must not get a second one, both restarting the shell. One that is just
    stopping lets go of the lock in a moment, and is waited for."""
    until = time.monotonic() + 8
    while True:
        if daemon_alive():
            return True
        f = take_lock()
        if f is not None:
            f.close()
            return False
        if time.monotonic() > until:
            return True
        time.sleep(0.25)


def supervisor_stale() -> bool:
    """Does the running supervisor belong to a Hyprland session that has ended? (One from
    before it said so is known by what it was started with.)"""
    try:
        st = send_to_daemon({"cmd": "status"}, timeout=3)
    except (OSError, ValueError):
        return False
    sig = st.get("hyprland")
    if sig is None:
        try:
            sig = session_of(int(st.get("pid") or 0))
        except (TypeError, ValueError):
            return False
    return bool(sig) and sig != HYPR_SIG and not hyprland_alive(sig)


def cmd_start(args) -> int:
    if supervisor_there():
        if not supervisor_stale():
            print("aequalyn-watchdog is already running")
            return 0
        # left from a session that was logged out of: replaced, never adopted
        print("aequalyn-watchdog: the running one is of an ended Hyprland session; replacing it")
        try:
            send_to_daemon({"cmd": "stop-daemon", "args": [True]}, timeout=30)
        except (OSError, ValueError):
            pass
        until = time.monotonic() + 15
        while True:
            f = take_lock()
            if f is not None:
                f.close()
                break
            if time.monotonic() > until:
                print("aequalyn-watchdog: the old one did not stop", file=sys.stderr)
                return 1
            time.sleep(0.25)
    conf = {**DEFAULTS, **read_json(WATCHDOG_CONF, {})}
    if not shutil.which(QS_BIN):
        print("aequalyn-watchdog: qs/quickshell not found", file=sys.stderr)
        return 127
    if args.foreground:
        lock = take_lock()
        if lock is None:
            print("aequalyn-watchdog is already running")
            return 0
        Supervisor(conf).run(adopt=True)
        lock.close()
        return 0
    # detach: double fork, own session, output to the log
    if os.fork() > 0:
        # the parent waits for the socket so "start" never reports success
        # before the supervisor can actually be reached -- a slow machine
        # (a live ISO on squashfs, a cold VM) gets a long wait, not a
        # premature failure and a racing unsupervised fallback shell
        for _ in range(60):
            if daemon_alive():
                return 0
            time.sleep(0.25)
        return 1
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    # the supervisor's own files are its user's alone; what it starts (the shell, and so every
    # program started from it, the installer too) keeps the session's mask: under this one
    # pacman's database would be root's alone, and "of an incorrect version" to everyone else
    global CHILD_UMASK
    CHILD_UMASK = os.umask(0o077)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(DAEMON_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    devnull = os.open(os.devnull, os.O_RDONLY)
    os.dup2(devnull, 0)
    # two starts at once: the second one leaves (a start that only looks holds the
    # lock for an instant)
    lock = None
    for _ in range(10):
        lock = take_lock()
        if lock is not None:
            break
        time.sleep(0.1)
    if lock is None:
        os._exit(0)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    Supervisor(conf).run(adopt=True)
    os._exit(0)


def cmd_ensure(_args) -> int:
    """For the shell's keep-alive timer: nothing to do when the supervisor is
    running (or was deliberately stopped), start it otherwise."""
    if STOP_MARKER.exists() or supervisor_there():
        return 0
    return cmd_start(_args)


def cmd_stop(args) -> int:
    if not daemon_alive():
        print("aequalyn-watchdog is not running")
        return 0
    out = send_to_daemon({"cmd": "stop-daemon", "args": [bool(getattr(args, "kill", False))]})
    print("stopped" if out.get("ok") else out.get("error", "failed"))
    return 0 if out.get("ok") else 1


def cmd_status(args) -> int:
    if not daemon_alive():
        print("aequalyn-watchdog is not running (start it: aequalyn-watchdog start)")
        return 1
    st = send_to_daemon({"cmd": "status"})
    if args.json:
        print(json.dumps(st, indent=2))
        return 0
    sh = st.get("shell", {})
    state = "up" if sh.get("running") else "DOWN"
    print(f"shell    {state:<6} pid {sh.get('pid') or '-':<8} "
          f"ram {sh.get('rssMiB', 0):>7.1f} MiB / {sh.get('budgetMiB')} MiB   "
          f"failures {sh.get('failures')}")
    for p in st.get("plugins", []):
        state = "up" if p.get("running") else "DOWN"
        print(f"{p['id']:<9}{state:<6} pid {p.get('pid') or '-':<8} "
              f"ram {p.get('rssMiB', 0):>7.1f} MiB / {p.get('budgetMiB')} MiB   "
              f"failures {p.get('failures')}"
              + (f"   [test: {p['test']}]" if p.get("test") else ""))
    if st.get("disabled"):
        print("turned off by the watchdog:")
        for pid, reason in st["disabled"].items():
            print(f"  {pid}: {reason}")
    return 0


def cmd_restart(args) -> int:
    who = args.id or "shell"
    if not daemon_alive():
        print("aequalyn-watchdog is not running", file=sys.stderr)
        return 1
    out = send_to_daemon({"cmd": "restart", "args": [who]})
    if out.get("ok"):
        print(f"restarted {out.get('restarted', who)}")
        return 0
    print(out.get("error", "failed"), file=sys.stderr)
    return 1


def cmd_restart_all(_args) -> int:
    if not daemon_alive():
        print("aequalyn-watchdog is not running", file=sys.stderr)
        return 1
    out = send_to_daemon({"cmd": "restart-all"})
    if out.get("ok"):
        print("planned restart: " + ", ".join(out.get("restarted", [])))
        return 0
    print(out.get("error", "failed"), file=sys.stderr)
    return 1


def cmd_toggle(args) -> int:
    if not daemon_alive():
        print("aequalyn-watchdog is not running", file=sys.stderr)
        return 1
    out = send_to_daemon({"cmd": args.direction, "args": [args.id] + ([args.reason] if getattr(args, "reason", None) else [])})
    if out.get("ok"):
        print(out.get("result", args.id + " " + args.direction + "d"))
        return 0
    print(out.get("error", "failed"), file=sys.stderr)
    return 1


def cmd_sandboxed(_args) -> int:
    conf = {**DEFAULTS, **read_json(WATCHDOG_CONF, {})}
    no = set(conf.get("noSandbox", []))
    forced = set(conf.get("forceSandbox", []))
    ids = (sandbox_builtins() | set(sandbox_store()) | forced) - no
    enabled = set(enabled_from_settings())
    print("sandboxed when enabled:")
    for i in sorted(ids):
        marks = []
        if i in sandbox_builtins():
            marks.append("Plugins.js")
        if i in sandbox_store():
            marks.append("store")
        if i in forced:
            marks.append("forced")
        print(f"  {i:<16} ({', '.join(marks)})" + ("" if i in enabled else "  [off]"))
    if no:
        print("never sandboxed:", ", ".join(sorted(no)))
    return 0


def cmd_log(args) -> int:
    path = DAEMON_LOG
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        print(f"no log at {path}", file=sys.stderr)
        return 1
    for line in lines[-args.n:]:
        print(line)
    return 0


def cmd_test(args) -> int:
    if not daemon_alive():
        print("aequalyn-watchdog is not running", file=sys.stderr)
        return 1
    out = send_to_daemon({"cmd": "test", "args": [args.id, args.mode]})
    if out.get("ok"):
        print(f"{args.id} restarted in test mode '{args.mode}'; watch it with: "
              f"aequalyn-watchdog status")
        return 0
    print(out.get("error", "failed"), file=sys.stderr)
    return 1


def cmd_exec_root(args) -> int:
    """A plugin's only door to root. The daemon pins the caller by its real
    process, the shell shows the window (plugin, action, exact command),
    and the outcome comes back as JSON on stdout."""
    conf = read_json(WATCHDOG_CONF, {})
    # the answer may take a while: a shell that is restarted is asked again
    wait = 120 + 3 * int(conf.get("escalationTimeoutSeconds", 120)) \
        + int(conf.get("escalationCommandTimeoutSeconds", 300))
    # a supervisor that is just starting (a login) is waited for; one that is there but
    # busy takes the request in and answers when it can
    until = time.monotonic() + 30
    while True:
        try:
            out = send_to_daemon({"cmd": "exec-root", "args": [args.as_id, args.action]},
                                 timeout=wait)
            break
        except socket.timeout:
            print("aequalyn-watchdog did not answer", file=sys.stderr)
            return 124
        except (OSError, ValueError):
            if time.monotonic() > until:
                print("aequalyn-watchdog is not running", file=sys.stderr)
                return 127
            time.sleep(0.5)
    print(json.dumps(out, indent=2))
    if not out.get("ok"):
        return out.get("code", 126) if isinstance(out.get("code"), int) else 126
    return int(out.get("code", 1))


def cmd_decide(args) -> int:
    """The shell's escalation window calls this: its decision, with the
    password on stdin (never argv, never a log line). One line, bounded
    wait -- a window that failed to write must not leave this hanging."""
    pwd = ""
    try:
        if not sys.stdin.isatty():
            import select
            if select.select([sys.stdin], [], [], 10.0)[0]:
                pwd = sys.stdin.readline().rstrip("\n")
    except OSError:
        pwd = ""
    out = send_to_daemon({"cmd": "decide", "args": [args.request, args.decision],
                          "password": pwd[:256]}, timeout=60)
    if out.get("ok"):
        return 0
    print(out.get("error", "failed"), file=sys.stderr)
    return 1


def cmd_root_actions(_args) -> int:
    """What every plugin declared it wants root for (works without the daemon:
    it reads the manifests)."""
    found = False
    ids = sorted({p.parent.name for p in STORE_DIR.glob("*/plugin.json")}
                 | set(builtin_root_actions()))
    for pid in ids:
        acts = root_actions_of(pid)
        if not acts:
            continue
        found = True
        where = "store" if (STORE_DIR / pid / "plugin.json").is_file() else "built-in"
        print(f"{pid} ({where}):")
        for a in acts:
            print(f"  {a['id']:<14} {a['label']}")
            print(f"  {'':<14} command: {' '.join(a['command'])}")
    if not found:
        print("no plugin declares any root action")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="aequalyn-watchdog",
        description="Supervise the Aequalyn QuickShell shell and sandbox its plugins.")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("start", help="start the supervisor (idempotent; adopts a running shell)")
    p.add_argument("--foreground", action="store_true", help="stay attached to the terminal")
    p.add_argument("--adopt", action="store_true",
                  help="adopt a running shell instead of starting a new one (the default)")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("run", help="start in the foreground (same as start --foreground)")
    p.set_defaults(fn=cmd_start, foreground=True, adopt=True)

    p = sub.add_parser("ensure", help="start the supervisor unless it is running or was stopped by hand")
    p.set_defaults(fn=cmd_ensure, foreground=False, adopt=True)

    p = sub.add_parser("stop", help="stop the supervisor (the shell and plugins keep running)")
    p.add_argument("--kill", action="store_true", help="also stop the supervised processes")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("status", help="shell + sandboxed plugin state")
    p.add_argument("--json", action="store_true", help="machine-readable")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("list", help="same as status")
    p.set_defaults(fn=cmd_status, json=False)

    p = sub.add_parser("restart", help="restart the shell or one plugin")
    p.add_argument("id", nargs="?", default="shell", help="a plugin id, or 'shell'")
    p.set_defaults(fn=cmd_restart)

    p = sub.add_parser("restart-all",
                       help="planned restart of the shell and every sandboxed plugin (what an update calls)")
    p.set_defaults(fn=cmd_restart_all)

    p = sub.add_parser("enable", help="turn a plugin on (through the shell)")
    p.add_argument("id")
    p.set_defaults(fn=cmd_toggle, direction="enable")

    p = sub.add_parser("disable", help="turn a plugin off (through the shell)")
    p.add_argument("id")
    p.add_argument("reason", nargs="?", default="")
    p.set_defaults(fn=cmd_toggle, direction="disable")

    p = sub.add_parser("sandboxed", help="which plugins would run out of process")
    p.set_defaults(fn=cmd_sandboxed)

    p = sub.add_parser("log", help="tail the watchdog's log")
    p.add_argument("-n", type=int, default=30)
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("test", help="restart a sandboxed plugin in a failure-test mode")
    p.add_argument("id")
    p.add_argument("mode", choices=["leak", "hang", "crash", "esc"],
                   help="leak: breach the RAM budget; hang: stop answering; crash: die hard; "
                        "esc: reach for root without the gate (the tripwire stops it)")
    p.set_defaults(fn=cmd_test)

    p = sub.add_parser("exec-root",
                       help="run one of this plugin's DECLARED root actions (an approval window asks first)")
    p.add_argument("action", help="the action id, as declared in the manifest's needsRoot")
    p.add_argument("--as", dest="as_id", default="",
                   help="the built-in asking for it, when it runs in-process "
                        "(sandboxed plugins are pinned by their process instead)")
    p.set_defaults(fn=cmd_exec_root)

    p = sub.add_parser("decide", help="answer an escalation request (the shell's window calls this)")
    p.add_argument("request")
    p.add_argument("decision", choices=["once", "always", "deny"])
    p.set_defaults(fn=cmd_decide)

    p = sub.add_parser("root-actions", help="every root action declared by every plugin")
    p.set_defaults(fn=cmd_root_actions)

    args = ap.parse_args()
    if os.geteuid() == 0:
        # the whole chain -- this supervisor, qs, every plugin -- is a user
        # session; running it as root would put the desktop, and every
        # plugin's escalation, on the other side of the wall the gate keeps
        print("aequalyn-watchdog must not run as root: it supervises a user "
              "session (QuickShell). Start it as your user -- "
              "aequalyn-session-start does.", file=sys.stderr)
        return 126
    if not hasattr(args, "fn"):
        ap.print_help()
        return 0
    return args.fn(args) or 0


if __name__ == "__main__":
    sys.exit(main())
