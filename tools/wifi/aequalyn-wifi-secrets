#!/usr/bin/env python3
"""Root half of Settings > Wi-Fi > Reveal password.

The user-facing half stages the selected SSID in
~/.local/state/aequalyn/gate/wifi-reveal.json and asks the watchdog gate to run
this file as root. It prints the saved secret as one JSON object, which the
caller displays only after the person approved the request in the escalation
window. The SSID is validated and the staging file is removed after reading.
"""

import json
import os
import pwd
import sys


def emit(obj, code=0):
    print(json.dumps(obj, sort_keys=True))
    sys.exit(code)


def fail(message):
    emit({"ok": False, "error": message}, 1)


def staged_path():
    user = os.environ.get("SUDO_USER", "")
    if not user:
        fail("no SUDO_USER: this helper is only for the watchdog gate")
    try:
        home = pwd.getpwnam(user).pw_dir
    except KeyError:
        fail("unknown user: %s" % user)
    return os.path.join(home, ".local/state/aequalyn/gate/wifi-reveal.json")


def read_request(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            request = json.loads(f.read(4096))
    except Exception as e:
        fail("could not read the staged request: %s" % e)
    ssid = request.get("ssid") if isinstance(request, dict) else None
    if not isinstance(ssid, str) or not ssid or "\0" in ssid or len(ssid.encode("utf-8")) > 32:
        fail("invalid SSID in the staged request")
    return ssid


def unpack(variant):
    try:
        return variant.unpack()
    except Exception:
        return {}


def main():
    path = staged_path()
    ssid = read_request(path)
    try:
        os.unlink(path)
    except OSError:
        pass

    try:
        import gi

        gi.require_version("NM", "1.0")
        from gi.repository import NM
    except Exception as e:
        fail("libnm is unavailable: %s" % e)

    try:
        client = NM.Client.new(None)
        connection = None
        for candidate in client.get_connections():
            if candidate.get_id() == ssid:
                connection = candidate
                break
        if connection is None:
            fail("no saved connection named %s" % ssid)

        secret = ""
        kind = ""
        for setting, key in (("802-11-wireless-security", "psk"), ("802-1x", "password")):
            try:
                values = unpack(connection.get_secrets(setting, None))
                section = values.get(setting, {})
                value = section.get(key) if isinstance(section, dict) else None
                if value is not None:
                    secret = str(unpack(value)) if hasattr(value, "unpack") else str(value)
                    kind = key
                    break
            except Exception:
                continue
        if not secret:
            fail("no saved password found for %s" % ssid)
        emit({"ok": True, "ssid": ssid, "password": secret, "kind": kind})
    except SystemExit:
        raise
    except Exception as e:
        fail("could not read the saved password: %s" % e)


if __name__ == "__main__":
    main()
